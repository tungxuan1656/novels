#!/usr/bin/env bash
set -e

# Pre-commit hook for Novels — SwiftFormat + SwiftLint
# Blocks commit on formatting or lint violations.
# Tools: swiftformat (brew install swiftformat), swiftlint (brew install swiftlint)

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Collect staged Swift files (Added, Copied, Modified)
STAGED_SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.swift$' || true)

if [ -z "$STAGED_SWIFT_FILES" ]; then
    echo -e "${GREEN}[pre-commit] No staged Swift files — skipping lint/format checks.${NC}"
    exit 0
fi

echo -e "${BLUE}[pre-commit] Checking staged Swift files:${NC}"
echo "$STAGED_SWIFT_FILES" | sed 's/^/  - /'

HAS_ERROR=0

# --- SwiftFormat check (staged files only, verbose output) ---
if command -v swiftformat >/dev/null 2>&1; then
    echo -e "${BLUE}[pre-commit] Running SwiftFormat --lint ...${NC}"
    if ! echo "$STAGED_SWIFT_FILES" | xargs swiftformat --lint 2>&1; then
        echo -e "${RED}[pre-commit] SwiftFormat violations found.${NC}"
        echo -e "${YELLOW}  Run:  swiftformat .${NC}"
        echo -e "${YELLOW}  Or for staged files:  echo \"\$STAGED\" | xargs swiftformat${NC}"
        echo -e "${YELLOW}  Then: git add -u && git commit${NC}"
        HAS_ERROR=1
    else
        echo -e "${GREEN}[pre-commit] SwiftFormat passed.${NC}"
    fi
else
    echo -e "${YELLOW}[pre-commit] swiftformat not found — skipping format check (install: brew install swiftformat).${NC}"
fi

# --- SwiftLint check (full project, single run) ---
if command -v swiftlint >/dev/null 2>&1; then
    echo -e "${BLUE}[pre-commit] Running SwiftLint lint --strict ...${NC}"
    if ! swiftlint lint --strict 2>&1; then
        echo -e "${RED}[pre-commit] SwiftLint violations found (strict).${NC}"
        echo -e "${YELLOW}  Run:  swiftlint lint --strict --fix  (auto-fixable)${NC}"
        echo -e "${YELLOW}  Or:   swiftlint lint --strict${NC}"
        HAS_ERROR=1
    else
        echo -e "${GREEN}[pre-commit] SwiftLint passed.${NC}"
    fi
else
    echo -e "${YELLOW}[pre-commit] swiftlint not found — skipping lint check (install: brew install swiftlint).${NC}"
fi

if [ "$HAS_ERROR" -ne 0 ]; then
    echo -e "${RED}[pre-commit] Commit blocked — fix violations above.${NC}"
    exit 1
fi

echo -e "${GREEN}[pre-commit] All checks passed.${NC}"
exit 0
